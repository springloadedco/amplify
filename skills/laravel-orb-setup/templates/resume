#!/usr/bin/env bash
# Runs when an Amp orb starts and every time it wakes. Generated by Amplify (https://github.com/springloadedco/amplify).
#
# Amp waits only 10 seconds for this hook, so it installs nothing and makes no network calls.
set -euo pipefail

# Start the databases .agents/setup installed; `systemctl start` is a no-op for running units.
for unit in mysql mariadb postgresql redis-server; do
	if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
		sudo systemctl start "$unit"
		echo "$unit: $(systemctl is-active "$unit")"
	fi
done

# Laravel Forge CLI: it reads FORGE_API_TOKEN from the environment, but the current organization
# and server only from ~/.laravel-forge/config.json. Fill those in from FORGE_ORGANIZATION (the
# organization slug) and FORGE_SERVER (the server ID). The token is never written to disk.
if [ -n "${FORGE_API_TOKEN:-}" ] && { [ -n "${FORGE_ORGANIZATION:-}" ] || [ -n "${FORGE_SERVER:-}" ]; }; then
	config="$HOME/.laravel-forge/config.json"
	mkdir -p "$(dirname "$config")"
	[ -s "$config" ] || echo '{}' >"$config"
	jq --arg org "${FORGE_ORGANIZATION:-}" --arg server "${FORGE_SERVER:-}" '
		del(.token)
		| if $org != "" then .organization = $org else . end
		| if $server != "" then .server = ($server | tonumber? // .) else . end
	' "$config" >"$config.tmp" && mv "$config.tmp" "$config"
	echo "forge: organization ${FORGE_ORGANIZATION:-unset}, server ${FORGE_SERVER:-unset}"
fi
