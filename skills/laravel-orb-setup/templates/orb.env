# Local ports and settings for Amplify's orb services. Generated by Amplify (https://github.com/springloadedco/amplify).
# Every command in .amp/services.yaml loads this file, so a port is set in exactly one place.
# Change a port if it clashes with something else the app runs in the orb, then run
# `amp orb services ensure`.
AMPLIFY_APP_PORT=8000
AMPLIFY_VITE_PORT=5173
REVERB_PORT=8080
MAIL_PORT=1025

# Point the app at the orb's own services. Real environment variables override .env.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
REVERB_HOST=127.0.0.1
REVERB_SCHEME=http
