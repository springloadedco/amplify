#!/usr/bin/env bash
# Prepares an Amp orb for this Laravel app. Generated by Amplify (https://github.com/springloadedco/amplify).
#
# Amp runs this on fresh orbs and snapshots the result, and people may run it again by hand,
# so every step checks what is already done. It reads the project at run time (composer.json,
# lockfiles, .env), so it keeps working as the app changes. Long-running processes belong in
# .amp/services.yaml, not here.
#
# Override with project environment variables in Amp settings:
#   AMPLIFY_PHP_VERSION              PHP version to install, e.g. 8.3 (default: the newest composer.json and composer.lock allow)
#   AMPLIFY_PHP_EXTENSIONS           extra apt PHP extensions, e.g. "imagick swoole"
#   AMPLIFY_COMPOSER_GLOBAL_PACKAGES global Composer packages (default: laravel/installer laravel/cloud-cli laravel/forge-cli)
#   AMPLIFY_DATABASE                 sqlite, mysql, mariadb, or pgsql (default: below)
#   AMPLIFY_DATABASE_VERSION         e.g. 8.4 for MySQL, 17 for PostgreSQL (default: below)
#   AMPLIFY_FRESH_SEED               1 to run migrate:fresh --seed, 0 to only migrate (default: below)
#   AMPLIFY_BOOST_INSTALL            1 to run boost:install for Amp, 0 to skip (default: below)
set -euo pipefail

cd "$(dirname "$0")/.."

# The database this app runs on in orbs, as chosen when Amplify set the project up. Empty means
# DB_CONNECTION from .env. The version is MySQL 8.0/8.4, MariaDB 10.11/11.4/..., PostgreSQL 13-18;
# empty means MySQL 8.4, PostgreSQL 17, or Debian's MariaDB 10.11.
database=${AMPLIFY_DATABASE:-}
database_version=${AMPLIFY_DATABASE_VERSION:-}

# 1: every new orb starts from a fresh, seeded database (migrate:fresh --seed), so the app has the
# seeders' users and data. 0: only run pending migrations. Rerunning setup with 1 wipes the
# orb's local database.
fresh_seed=${AMPLIFY_FRESH_SEED:-1}

# 1: run `php artisan boost:install` for Amp, so the orb has Boost's guidelines, skills, and MCP
# server. It writes Boost's generated files; skip it if the repository commits them.
boost_install=${AMPLIFY_BOOST_INSTALL:-1}

log() { printf '\n\033[1;35m[amplify]\033[0m %s\n' "$*"; }

env_value() { # env_value KEY [default] — read KEY from .env
	local value
	value=$(grep -E "^$1=" .env 2>/dev/null | tail -n1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")
	printf '%s' "${value:-${2:-}}"
}

set_env() { # set_env KEY VALUE — set KEY in .env, uncommenting a "# KEY=" line if there is one
	if grep -qE "^$1=" .env; then
		sed -i "s|^$1=.*|$1=$2|" .env
	elif grep -qE "^# ?$1=" .env; then
		sed -i "0,/^# \\?$1=.*/s||$1=$2|" .env
	else
		printf '%s=%s\n' "$1" "$2" >>.env
	fi
}

apt_updated=0
apt_install() {
	local missing=()
	for pkg in "$@"; do
		dpkg -s "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
	done
	[ ${#missing[@]} -eq 0 ] && return
	if [ "$apt_updated" = 0 ]; then
		sudo apt-get update -qq
		apt_updated=1
	fi
	sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "${missing[@]}"
}

# --- PHP ---------------------------------------------------------------------------------------

semver_num() { # semver_num 8.2.5 -> 80205
	local a b c
	IFS=. read -r a b c <<<"$1"
	echo $((${a:-0} * 10000 + ${b:-0} * 100 + ${c:-0}))
}

php_satisfies() { # php_satisfies 8.4 '^8.2 || ^9.0' — can some 8.4.x release satisfy the Composer constraint?
	local cand_lo cand_hi alt term op v a b c lo hi ok terms
	cand_lo=$(semver_num "$1.0")
	cand_hi=$(semver_num "$1.99")
	while read -r alt; do
		ok=1
		read -ra terms <<<"$(sed -E 's/([0-9][0-9.]*) +- +([0-9][0-9.]*)/>=\1 <=\2/g; s/@[a-z]+//g; s/,/ /g; s/(>=|<=|!=|>|<|=|\^|~) +/\1/g' <<<"$alt")"
		for term in "${terms[@]}"; do
			op=$(grep -oE '^(>=|<=|!=|>|<|=|\^|~)' <<<"$term" || true)
			v=${term#"$op"}
			v=${v#v}
			v=${v%.\*}
			[ "$v" = '*' ] || [ "$op" = '!=' ] && continue
			IFS=. read -r a b c <<<"$v"
			lo=$(semver_num "$v")
			case $op in
			'^') hi=$(((a + 1) * 10000)) ;;
			'~') if [ -n "$c" ]; then hi=$((a * 10000 + (b + 1) * 100)); else hi=$(((a + 1) * 10000)); fi ;;
			'>=') hi=999999 ;;
			'>') lo=$((lo + 1)) hi=999999 ;;
			'<=') hi=$((lo + 1)) lo=0 ;;
			'<') hi=$lo lo=0 ;;
			*) # exact or wildcard: 8, 8.2, 8.2.*, 8.2.5
				if [ -n "$c" ]; then hi=$((lo + 1)); elif [ -n "$b" ]; then hi=$((a * 10000 + (b + 1) * 100)); else hi=$(((a + 1) * 10000)); fi ;;
			esac
			[ "$cand_hi" -ge "$lo" ] && [ "$cand_lo" -lt "$hi" ] || ok=0
		done
		[ "$ok" = 1 ] && return 0
	done < <(sed 's/||*/\n/g' <<<"$2")
	return 1
}

# PHP comes from Composer. config.platform.php pins it exactly, because Composer resolves the lock
# file against it. Otherwise use the newest PHP that composer.json's require.php and every locked
# package's PHP requirement allow.
apt_install jq
php_version=${AMPLIFY_PHP_VERSION:-$(jq -r '.config.platform.php // empty' composer.json | grep -oE '^[0-9]+\.[0-9]+' || true)}
if [ -z "$php_version" ]; then
	mapfile -t php_constraints < <(
		jq -r '.require.php // empty' composer.json
		[ ! -f composer.lock ] || jq -r '(.packages + (.["packages-dev"] // []))[] | .require.php // empty' composer.lock | sort -u
	)
	for candidate in 8.5 8.4 8.3 8.2; do
		fits=1
		for constraint in "${php_constraints[@]}"; do
			php_satisfies "$candidate" "$constraint" || { fits=0 && break; }
		done
		[ "$fits" = 1 ] && php_version=$candidate && break
	done
fi
php_version=${php_version:-8.4}

if [ ! -f /etc/apt/sources.list.d/php.list ]; then
	log "Adding the packages.sury.org PHP repository"
	apt_install ca-certificates curl lsb-release
	curl -fsSLo /tmp/debsuryorg-archive-keyring.deb https://packages.sury.org/debsuryorg-archive-keyring.deb
	sudo dpkg -i /tmp/debsuryorg-archive-keyring.deb >/dev/null
	echo "deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ $(lsb_release -sc) main" |
		sudo tee /etc/apt/sources.list.d/php.list >/dev/null
	apt_updated=0
fi

log "Installing PHP $php_version"
extensions=(bcmath curl gd intl mbstring mysql pgsql readline redis sqlite3 xml zip ${AMPLIFY_PHP_EXTENSIONS:-})
apt_install "php$php_version-cli" "${extensions[@]/#/php$php_version-}" unzip
sudo update-alternatives --set php "/usr/bin/php$php_version" >/dev/null

# --- Composer ----------------------------------------------------------------------------------

if ! command -v composer >/dev/null 2>&1; then
	log "Installing Composer"
	curl -fsSL https://getcomposer.org/installer | php -- --quiet --install-dir=/tmp
	sudo mv /tmp/composer.phar /usr/local/bin/composer
fi

global_packages=${AMPLIFY_COMPOSER_GLOBAL_PACKAGES-laravel/installer laravel/cloud-cli laravel/forge-cli}
if [ -n "$global_packages" ]; then
	log "Installing global Composer packages: $global_packages"
	# shellcheck disable=SC2086
	composer global require --quiet --no-interaction $global_packages
	# Link global binaries into /usr/local/bin so non-login shells (the agent's) find them too.
	global_bin=$(composer global config bin-dir --absolute 2>/dev/null)
	for bin in "$global_bin"/*; do
		if [ -x "$bin" ]; then sudo ln -sf "$bin" "/usr/local/bin/$(basename "$bin")"; fi
	done
fi

# --- Mailpit -----------------------------------------------------------------------------------
# Catches the app's outgoing mail; the `mail` service in .amp/services.yaml runs it.

mailpit_version=v1.33.0
if [[ "$(mailpit version 2>/dev/null || true)" != *"$mailpit_version"* ]]; then
	log "Installing Mailpit $mailpit_version"
	case "$(dpkg --print-architecture)" in
	amd64) mailpit_arch=amd64 mailpit_sha=d0ec50080cbf3e7c1fa2cda2ee68125d7894175811084b1f8f47c6cfc6f487c8 ;;
	arm64) mailpit_arch=arm64 mailpit_sha=1d27c819e1a5dd2761ed9fd07022443e35a47793b2e92de5b49cf3656a649ef9 ;;
	esac
	archive=$(mktemp)
	curl -fsSL "https://github.com/axllent/mailpit/releases/download/$mailpit_version/mailpit-linux-$mailpit_arch.tar.gz" -o "$archive"
	echo "$mailpit_sha  $archive" | sha256sum --check --quiet
	sudo tar -xzf "$archive" -C /usr/local/bin mailpit
	rm "$archive"
fi

# --- Project dependencies ----------------------------------------------------------------------

log "Installing Composer dependencies"
composer install --no-interaction --no-progress --prefer-dist

js=npm
if [ -f package.json ]; then
	log "Installing JavaScript dependencies"
	if [ -f pnpm-lock.yaml ]; then
		js=pnpm
		pnpm install --frozen-lockfile
	elif [ -f bun.lock ] || [ -f bun.lockb ]; then
		js=bun
		bun install --frozen-lockfile
	elif [ -f yarn.lock ]; then
		js=yarn
		yarn install --immutable
	elif [ -f package-lock.json ]; then
		npm ci --no-audit --no-fund
	else
		npm install --no-audit --no-fund
	fi
fi

# --- Environment -------------------------------------------------------------------------------

if [ ! -f .env ] && [ -f .env.example ]; then
	log "Creating .env from .env.example"
	cp .env.example .env
fi
if [ -f .env ] && [ -z "$(env_value APP_KEY)" ]; then
	php artisan key:generate --no-interaction
fi

# --- Database ----------------------------------------------------------------------------------
# Server databases run under systemd, so they survive setup and start in every orb restored from
# the snapshot. The orb's .env is pointed at the local server; it is never committed.

database=${database:-$(env_value DB_CONNECTION sqlite)}
[ "$(env_value DB_CONNECTION)" = "$database" ] || set_env DB_CONNECTION "$database"

if [ "$database" != sqlite ]; then
	set_env DB_HOST 127.0.0.1
	[ "$database" = pgsql ] && set_env DB_PORT 5432 || set_env DB_PORT 3306
	[ -n "$(env_value DB_DATABASE)" ] || set_env DB_DATABASE laravel
	[ -n "$(env_value DB_USERNAME)" ] || set_env DB_USERNAME root
fi
db_database=$(env_value DB_DATABASE laravel)
db_username=$(env_value DB_USERNAME root)
db_password=$(env_value DB_PASSWORD)

case "$database" in
sqlite)
	if [ "$db_database" = laravel ] || [ -z "$db_database" ]; then
		db_file=database/database.sqlite
	else
		db_file=$db_database
	fi
	[ -f "$db_file" ] || touch "$db_file"
	;;
mysql | mariadb)
	if [ "$database" = mysql ]; then
		mysql_version=${database_version:-8.4}
		[ "$mysql_version" = 8.4 ] && mysql_suite=mysql-8.4-lts || mysql_suite=mysql-$mysql_version
		log "Installing MySQL $mysql_version"
		if ! grep -qs " $mysql_suite\$" /etc/apt/sources.list.d/mysql.list; then
			curl -fsSL https://repo.mysql.com/RPM-GPG-KEY-mysql-2025 | sudo tee /usr/share/keyrings/mysql.asc >/dev/null
			echo "deb [signed-by=/usr/share/keyrings/mysql.asc] https://repo.mysql.com/apt/debian/ $(lsb_release -sc) $mysql_suite" |
				sudo tee /etc/apt/sources.list.d/mysql.list >/dev/null
			apt_updated=0
		fi
		apt_install mysql-community-server mysql-community-client
		unit=mysql conf_dir=/etc/mysql/mysql.conf.d
	else
		log "Installing MariaDB ${database_version:-from Debian}"
		if [ -n "$database_version" ] && ! grep -qs "/$database_version/" /etc/apt/sources.list.d/mariadb.list; then
			curl -fsSL https://r.mariadb.com/downloads/mariadb_repo_setup |
				sudo bash -s -- --mariadb-server-version="mariadb-$database_version" --skip-maxscale >/dev/null
			apt_updated=0
		fi
		apt_install mariadb-server
		unit=mariadb conf_dir=/etc/mysql/mariadb.conf.d
	fi
	# Durability is traded for speed: this server is disposable and listens only on loopback.
	printf '[mysqld]\nbind-address=127.0.0.1\ninnodb_flush_log_at_trx_commit=0\nskip-log-bin\n' |
		sudo tee "$conf_dir/99-amplify.cnf" >/dev/null
	sudo systemctl enable --now "$unit" >/dev/null
	# Laravel connects over TCP to 127.0.0.1, so only that account is touched; root@localhost keeps
	# its socket login for `sudo mysql`.
	sudo mysql -e "CREATE DATABASE IF NOT EXISTS \`$db_database\`;
		CREATE DATABASE IF NOT EXISTS \`testing\`;
		CREATE USER IF NOT EXISTS '$db_username'@'127.0.0.1' IDENTIFIED BY '$db_password';
		ALTER USER '$db_username'@'127.0.0.1' IDENTIFIED BY '$db_password';
		GRANT ALL PRIVILEGES ON *.* TO '$db_username'@'127.0.0.1';
		FLUSH PRIVILEGES;"
	;;
pgsql)
	pg_version=${database_version:-17}
	log "Installing PostgreSQL $pg_version"
	if [ ! -f /etc/apt/sources.list.d/pgdg.list ]; then
		sudo install -d /usr/share/postgresql-common/pgdg
		curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc |
			sudo tee /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc >/dev/null
		echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt $(lsb_release -sc)-pgdg main" |
			sudo tee /etc/apt/sources.list.d/pgdg.list >/dev/null
		apt_updated=0
	fi
	apt_install "postgresql-$pg_version"
	# The package does not always create a cluster (it skips it when another version has one),
	# and package scripts may not start services in an orb, so do both here.
	pg_lsclusters -h | awk -v v="$pg_version" '$1 == v' | grep -q . || sudo pg_createcluster "$pg_version" main >/dev/null
	sudo systemctl enable --now postgresql "postgresql@$pg_version-main" >/dev/null 2>&1
	# Trust loopback connections, whatever DB_PASSWORD is: this server is disposable.
	pg_hba=/etc/postgresql/$pg_version/main/pg_hba.conf
	if ! sudo grep -q amplify "$pg_hba"; then
		sudo sed -i '1i host all all 127.0.0.1/32 trust # amplify\nhost all all ::1/128 trust # amplify' "$pg_hba"
		sudo systemctl reload postgresql
	fi
	# Another installed version may hold 5432, so use this version's cluster port.
	pg_port=$(pg_lsclusters -h | awk -v v="$pg_version" '$1 == v { print $3 }')
	set_env DB_PORT "$pg_port"
	psql_admin() { sudo -u postgres psql -p "$pg_port" -tAc "$1"; }
	psql_admin "SELECT 1 FROM pg_roles WHERE rolname='$db_username'" | grep -q 1 ||
		psql_admin "CREATE ROLE \"$db_username\" WITH LOGIN SUPERUSER PASSWORD '$db_password'" >/dev/null
	for db in "$db_database" testing; do
		psql_admin "SELECT 1 FROM pg_database WHERE datname='$db'" | grep -q 1 ||
			psql_admin "CREATE DATABASE \"$db\" OWNER \"$db_username\"" >/dev/null
	done
	;;
*)
	echo "Unsupported database '$database'; use sqlite, mysql, mariadb, or pgsql." >&2
	exit 1
	;;
esac

if grep -qE '^(CACHE_STORE|QUEUE_CONNECTION|SESSION_DRIVER|BROADCAST_CONNECTION)=redis' .env 2>/dev/null; then
	log "Installing Redis"
	apt_install redis-server
	sudo systemctl enable --now redis-server >/dev/null
fi

# --- Application -------------------------------------------------------------------------------

if [ "$fresh_seed" = 1 ]; then
	log "Rebuilding and seeding the database"
	php artisan migrate:fresh --seed --force --no-interaction
else
	log "Running migrations"
	php artisan migrate --force --no-interaction
fi

# --- Laravel Boost ------------------------------------------------------------------------------
# Boost generates AGENTS.md, skills folders, and the MCP config from .ai/ and installed packages.
# Setup never adds or upgrades Boost itself; that is an app change.

if [ "$boost_install" = 1 ] && [ -f vendor/laravel/boost/composer.json ]; then
	log "Generating Laravel Boost guidelines, skills, and MCP config"
	[ -s boost.json ] || echo '{}' >boost.json
	if ! jq -e '(.agents // []) | index("amp")' boost.json >/dev/null; then
		jq '.agents = ((.agents // []) + ["amp"])' boost.json >boost.json.tmp && mv boost.json.tmp boost.json
	fi
	php artisan boost:install --no-interaction >/dev/null
fi

if [ -f package.json ] && grep -q '"build"' package.json; then
	log "Building frontend assets"
	$js run build
fi

log "Laravel orb setup complete"
